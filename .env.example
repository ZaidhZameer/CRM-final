# Next.js
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Trigger.dev (Background Jobs)
TRIGGER_API_KEY=your-api-key

# OpenAI (AI)
OPENAI_API_KEY=your-api-key

# Resend (Email)
RESEND_API_KEY=your-api-key

# Sentry (Observability)
NEXT_PUBLIC_SENTRY_DSN=your-dsn

# n8n automation (see docs/automation-api.yaml)
# Shared secret for BOTH directions, sent in the x-flowlead-secret header.
# Minimum 16 chars. If unset, /api/automation/result rejects every request (fail closed)
# and outbound lead.created events are skipped with a log line.
AUTOMATION_SHARED_SECRET=
# Where lead.created events are POSTed. If unset, emitting is silently skipped.
N8N_ADAPTER_URL=


