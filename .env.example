# Next.js
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Trigger.dev (Background Jobs)
TRIGGER_API_KEY=your-api-key

# OpenAI (AI)
OPENAI_API_KEY=your-api-key

# Resend (Email)
RESEND_API_KEY=your-api-key

# Sentry (Observability)
NEXT_PUBLIC_SENTRY_DSN=your-dsn

# n8n automation (see docs/automation-api.yaml)
# Shared secret for BOTH directions, sent in the x-flowlead-secret header.
# Minimum 16 chars. If unset, /api/automation/result rejects every request (fail closed)
# and outbound lead.created events are skipped with a log line.
# Must be the SAME value as the n8n-side `flowlead_shared_secret` row in
# agent-db's app_config table - the two are provisioned independently and
# nothing currently keeps them in sync automatically.
AUTOMATION_SHARED_SECRET=
# Where lead.created events are POSTed.
# ⚠️ NOT the workflow literally named "FlowLead Adapter" (rpHiiKJWpk1e9E1d) despite this
# variable's name - that workflow expects a phone number, which FlowLead leads don't have.
# Point this at the Lead Enrichment Pipeline's webhook instead:
#   http://<n8n-host>:5678/webhook/flowlead/lead-enrichment
# This event's payload (event_type/organization_id/lead_id/full_name/company_name/website,
# no phone) matches that workflow's contract exactly - confirmed 2026-09-18.
# If unset, emitting is silently skipped (lead creation must never fail because n8n is down).
N8N_ADAPTER_URL=


