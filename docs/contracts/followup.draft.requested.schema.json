{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "event_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "organization_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "subject_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "correlation_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "expected_version": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "event_type": {
      "type": "string",
      "const": "followup.draft.requested"
    },
    "payload": {
      "type": "object",
      "properties": {
        "lead_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "step": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "max_steps": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "scheduled_for": {
          "type": "string",
          "maxLength": 40
        },
        "latest_allowed": {
          "type": "string",
          "maxLength": 40
        },
        "contact": {
          "type": "object",
          "properties": {
            "full_name": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 500
                },
                {
                  "type": "null"
                }
              ]
            },
            "email": {
              "type": "string",
              "maxLength": 320
            },
            "company_name": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 500
                },
                {
                  "type": "null"
                }
              ]
            },
            "job_title": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 500
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "full_name",
            "email",
            "company_name",
            "job_title"
          ]
        },
        "research": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "company_summary": {
                  "anyOf": [
                    {
                      "type": "string",
                      "maxLength": 20000
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "pain_points": {
                  "anyOf": [
                    {
                      "maxItems": 50,
                      "type": "array",
                      "items": {
                        "type": "string",
                        "maxLength": 2000
                      }
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "recommended_offer": {
                  "anyOf": [
                    {
                      "type": "string",
                      "maxLength": 5000
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "outreach_angle": {
                  "anyOf": [
                    {
                      "type": "string",
                      "maxLength": 5000
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "next_best_action": {
                  "anyOf": [
                    {
                      "type": "string",
                      "maxLength": 5000
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "company_summary",
                "pain_points",
                "recommended_offer",
                "outreach_angle",
                "next_best_action"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "enquiry": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 5000
            },
            {
              "type": "null"
            }
          ]
        },
        "history": {
          "maxItems": 20,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "direction": {
                "type": "string",
                "enum": [
                  "outbound",
                  "inbound"
                ]
              },
              "subject": {
                "anyOf": [
                  {
                    "type": "string",
                    "maxLength": 500
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "body": {
                "type": "string",
                "maxLength": 10000
              },
              "at": {
                "type": "string",
                "maxLength": 40
              }
            },
            "required": [
              "direction",
              "subject",
              "body",
              "at"
            ]
          }
        },
        "sender": {
          "type": "object",
          "properties": {
            "name": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 200
                },
                {
                  "type": "null"
                }
              ]
            },
            "company": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 200
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "name",
            "company"
          ]
        },
        "rules": {
          "type": "object",
          "properties": {
            "booking_link_allowed": {
              "type": "boolean"
            },
            "max_words": {
              "type": "integer",
              "minimum": 30,
              "maximum": 400
            }
          },
          "required": [
            "booking_link_allowed",
            "max_words"
          ]
        }
      },
      "required": [
        "lead_id",
        "step",
        "max_steps",
        "scheduled_for",
        "latest_allowed",
        "contact",
        "research",
        "enquiry",
        "history",
        "sender",
        "rules"
      ]
    }
  },
  "required": [
    "event_id",
    "organization_id",
    "subject_id",
    "event_type",
    "payload"
  ]
}
